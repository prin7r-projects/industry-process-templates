# =============================================================================
# VerticalPlaybook / industry-process-templates — example env
# Copy to `.env` (never committed) and populate at deploy time.
# =============================================================================

# --- Landing (apps/landing) --------------------------------------------------

# Public app URL used in provider redirects and webhook callback URLs.
NEXT_PUBLIC_APP_URL=https://industry-process-templates.prin7r.com

# NOWPayments — DEFAULT crypto rail for VerticalPlaybook.
# Hosted invoice (USDT/USDC) + fiat-partner card on-ramp.
# Webhook signature: x-nowpayments-sig HMAC-SHA512 over sorted-keys JSON.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_SANDBOX=false

# --- App (apps/app — Wasp open-saas fork) -----------------------------------

# Database (optional; Wasp manages its own Postgres via `wasp start db`)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/verticalplaybook

# S3-compatible storage (MinIO)
AWS_S3_IAM_ACCESS_KEY=minioadmin
AWS_S3_IAM_SECRET_KEY=minioadmin
AWS_S3_FILES_BUCKET=verticalplaybook-bundles
AWS_S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true

# Email sender (Dummy for local dev; SendGrid for production)
# SENDGRID_API_KEY=

# Auth — Google OAuth (optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Admin users (comma-separated emails)
ADMIN_EMAILS=admin@industry-process-templates.prin7r.com

# OpenAI (optional)
# OPENAI_API_KEY=

# Plausible analytics (optional)
# PLAUSIBLE_API_KEY=
# PLAUSIBLE_SITE_ID=
# PLAUSIBLE_BASE_URL=https://plausible.io/api

# Delivery signing key — HMAC-SHA256 secret for bundle download token signing (Phase 1)
DELIVERY_SIGNING_KEY=dev-signing-key-change-in-prod

# Admin API key — Bearer auth for admin endpoints (license revocation, Phase 1)
ADMIN_API_KEY=

# n8n integration encryption key (Phase 3) — generate: openssl rand -hex 32
INTEGRATION_KEY=

# Notion integration (Phase 3)
# NOTION_API_KEY=
# NOTION_ORDERS_DSID=

# Postmark — transactional email (Phase 3)
# POSTMARK_SERVER_TOKEN=

# Product team notifications (Phase 3) — comma-separated emails
# PRODUCT_TEAM_EMAILS=

# --- Infrastructure services (docker-compose) --------------------------------

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=verticalplaybook

# Redis
REDIS_PASSWORD=redispass

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- Future-rail variable names; documented for Wave 3+ -----------------------

# Plisio — backup direct-stablecoin rail.
PLISIO_API_KEY=

# Reown / WalletConnect — wallet fallback (Wave 3).
NEXT_PUBLIC_REOWN_PROJECT_ID=

# Merchant settlement wallets — referenced only as documentation; never hardcoded.
MERCHANT_USDT_TRC20_ADDRESS=
MERCHANT_USDT_ERC20_ADDRESS=
MERCHANT_USDC_ERC20_ADDRESS=
MERCHANT_USDC_POLYGON_ADDRESS=
MERCHANT_USDT_BSC_ADDRESS=
