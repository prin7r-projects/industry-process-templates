# ---------------------------------------------------------------------------
# Plumbline / industry-process-templates — example env
# Copy to `.env` (never committed) and populate at deploy time on
# storage-contabo:/opt/prin7r-deploys/industry-process-templates/.env
# ---------------------------------------------------------------------------

# Public app URL used in provider redirects and webhook callback URLs.
NEXT_PUBLIC_APP_URL=https://industry-process-templates.prin7r.com

# NOWPayments — DEFAULT crypto rail for Plumbline.
# Hosted invoice (USDT/USDC) + fiat-partner card on-ramp.
# Webhook signature: x-nowpayments-sig HMAC-SHA512 over sorted-keys JSON.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_SANDBOX=false

# --- Future-rail variable names; not used in Wave 2 v1. -----------------------

# Plisio — backup direct-stablecoin rail.
PLISIO_API_KEY=

# Reown / WalletConnect — wallet fallback (Wave 3).
NEXT_PUBLIC_REOWN_PROJECT_ID=

# Merchant settlement wallets — referenced only as documentation; never hardcoded.
MERCHANT_USDT_TRC20_ADDRESS=
MERCHANT_USDT_ERC20_ADDRESS=
MERCHANT_USDC_ERC20_ADDRESS=
MERCHANT_USDC_POLYGON_ADDRESS=
MERCHANT_USDT_BSC_ADDRESS=
