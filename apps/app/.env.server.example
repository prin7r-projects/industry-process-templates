# VerticalPlaybook — server-side environment variables
# Copy to .env.server (never committed)

# Database (managed by Wasp; set if using external Postgres)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/verticalplaybook

# Auth — Google OAuth (optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Email — SendGrid or similar (Dummy provider used for local dev)
# SENDGRID_API_KEY=

# OpenAI (optional, for AI features)
# OPENAI_API_KEY=

# S3-compatible storage (MinIO on storage-contabo or AWS S3)
AWS_S3_IAM_ACCESS_KEY=minioadmin
AWS_S3_IAM_SECRET_KEY=minioadmin
AWS_S3_FILES_BUCKET=verticalplaybook-bundles
AWS_S3_REGION=us-east-1
# MinIO endpoint override (set for local dev)
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true

# Plausible analytics (optional)
# PLAUSIBLE_API_KEY=
# PLAUSIBLE_SITE_ID=
# PLAUSIBLE_BASE_URL=https://plausible.io/api

# Google Analytics (optional)
# GOOGLE_ANALYTICS_CLIENT_EMAIL=
# GOOGLE_ANALYTICS_PRIVATE_KEY=
# GOOGLE_ANALYTICS_PROPERTY_ID=

# Admin emails (comma-separated)
ADMIN_EMAILS=admin@industry-process-templates.prin7r.com

# NOWPayments — primary crypto rail (Phase 3)
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_SANDBOX=true

# Delivery signing key (wired in Phase 1)
# DELIVERY_SIGNING_KEY=

# n8n integration — encryption key for customer n8n API keys (Phase 3)
# Generate: openssl rand -hex 32
INTEGRATION_KEY=

# Notion sync — data source ID for VerticalPlaybook Orders database (Phase 3)
# NOTION_API_KEY=
# NOTION_ORDERS_DSID=

# Postmark — transactional email (Phase 3)
# POSTMARK_SERVER_TOKEN=

# Product team emails — receives vertical request notifications (Phase 3)
# PRODUCT_TEAM_EMAILS=
